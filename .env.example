# Copy to .env for local development. On Hostinger, add these as Environment Variables.

NEXT_PUBLIC_SITE_URL=https://flowervsflorist.com

# Database — EITHER the 5 DB_* values (recommended on Hostinger) OR one DATABASE_URL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME
# Tables + starting catalog are created automatically on first start. Set to false to disable.
# DB_AUTO_SETUP=true

# Auth — AUTH_SECRET: 32+ random characters. ADMIN_PASSWORD_HASH: from `npm run hash-password -- "password"`
AUTH_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Stripe — without STRIPE_SECRET_KEY, checkout takes "pay later" order requests
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Email (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@flowervsflorist.com
SMTP_PASS=
SHOP_EMAIL=contact@flowervsflorist.com

# Optional: where admin-uploaded images are stored (default: ~/flowervsflorist-uploads)
# UPLOAD_DIR=/home/u123456789/flowervsflorist-uploads
